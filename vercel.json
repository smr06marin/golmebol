{
    "functions": {
      "api/push-enviar.js": { "maxDuration": 60 },
      "api/soporte-enviar.js": { "maxDuration": 60, "includeFiles": "node_modules/ffmpeg-static/**" },
      "api/telegram-webhook.js": { "maxDuration": 60, "includeFiles": "node_modules/ffmpeg-static/**" },
      "api/soporte-limpiar.js": { "maxDuration": 60 }
    },
    "crons": [
      { "path": "/api/soporte-limpiar", "schedule": "0 8 * * *" },
      { "path": "/api/soporte-resumen", "schedule": "0 12 * * *" }
    ],
    "rewrites": [
      { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "/modelos-rostro/(.*)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/assets/(.*)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }
